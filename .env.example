# Copy to .env and fill in. Never paste keys into prompts.
ZOOWORK_API_KEY=
# Set to 1 once server/zoowork.js is implemented with the ZooWork skill
USE_ZOOWORK=0
# Set to 1 once server/band.js is implemented
USE_BAND=0
# Public URL that the QR code points to (your tunnel or deploy URL)
PUBLIC_URL=http://localhost:5173
# Night seed. Empty = a different night every run (day of week, deliveries, stock).
# Set a number (e.g. NIGHT_SEED=7) to replay the same night for rehearsals. npm run inventory prints tonight's seed.
NIGHT_SEED=
# Optional: pin tonight's date (YYYY-MM-DD). Otherwise the seed picks the day of the week.
CLOSING_DATE=
# 1 = normal pacing, 0.5 = twice as fast
SPEED=1
PORT=3001
